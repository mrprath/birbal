# Birbal credentials — copy to .env and fill in real values
# See SECURITY.md DR-2 for credential storage rules
#
# Rules:
#   - Never commit .env (gitignored + pre-commit hook)
#   - Base64-encode multiline values (cookies, refresh tokens)
#   - chmod 600 is enforced on every write

# GitHub
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Substack (if API access becomes available)
SUBSTACK_EMAIL=
SUBSTACK_PASSWORD=

# Notion
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_HOME_PAGE=
NOTION_ALL_POSTS=
NOTION_NEWS_DB=
NOTION_SUBS_DB=
NOTION_OPS_PAGE=

# Microsoft Graph (OAuth access token — JWT, short-lived)
GRAPH_ACCESS_TOKEN=

# TypeSafe / Jev (System One API key)
TYPESAFE_API_KEY=

# Anthropic (fallback for judge.js when TYPESAFE_API_KEY absent)
ANTHROPIC_API_KEY=

# Gmail OAuth2 (for email-sort, newsletter skills)
# Setup: console.cloud.google.com -> Gmail API -> OAuth2 credentials
# Run: node scripts/gmail-auth.mjs
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_ACCESS_TOKEN=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=

# Beehiiv (newsletter subscriber management)
BEEHIIV_API_KEY=
BEEHIIV_PUB_ID=

# Replicate (Demucs, Depth Anything Video, SAM3 -- genjutsu skill)
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Enhancor / Seedance 2.5 (genjutsu video generation)
ENHANCOR_API_KEY=
ENHANCOR_BASE_URL=https://apireq.enhancor.ai/api/seedance2.5/v1
ENHANCOR_WEBHOOK_URL=

# Media hosting for Enhancor uploads (tmpfiles or catbox)
MEDIA_HOST=tmpfiles
MEDIA_HOST_FALLBACKS=catbox
CATBOX_USERHASH=

# OpenAI (Whisper voice transcription)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cesium ion (photorealistic 3D globe, world terrain — free Community plan)
CESIUM_ION_TOKEN=

# AISStream (live global ship tracking — free signup)
AISSTREAM_API_KEY=

# NASA FIRMS (live active fire detection — free)
FIRMS_MAP_KEY=

# TomTom (live traffic flow/congestion — free tier 200K tiles/month)
TOMTOM_API_KEY=

# Mapillary (street-level imagery — free)
MAPILLARY_CLIENT_TOKEN=
MAPILLARY_CLIENT_SECRET=

# OpenSky (higher flight polling — free, works anonymous without)
OPENSKY_AUTH_MODE=oauth
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Google Maps (browser — 3D tiles + geocoding, metered)
GOOGLE_MAPS_API_KEY=
# Google Maps (server — Places + Street View, metered)
GOOGLE_MAPS_SERVER_API_KEY=

# Brave Search (web + news search API)
BRAVE_API_KEY=BSA_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vercel (site deployment)
VERCEL_TOKEN=vck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VERCEL_PROJECT_EMAIL=
