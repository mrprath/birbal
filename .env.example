# Birbal credentials — copy to .env and fill in real values
# See SECURITY.md DR-2 for credential storage rules
#
# Rules:
#   - Never commit .env (gitignored + pre-commit hook)
#   - Base64-encode multiline values (cookies, refresh tokens)
#   - chmod 600 is enforced on every write

# GitHub
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Substack (if API access becomes available)
SUBSTACK_EMAIL=
SUBSTACK_PASSWORD=

# Notion (if using personal API token instead of MCP OAuth)
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
